<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Pinotechrd.Templates</PackageId>
    <PackageVersion>0.1.0-preview.1</PackageVersion>
    <Title>Pinotechrd project templates</Title>
    <Authors>Pinotechrd</Authors>
    <Description>Project templates for Pinotechrd applications: a .NET API and a Vue frontend with security, multi-tenancy and i18n built in.</Description>
    <PackageTags>dotnet-new;templates;aspnetcore;vue;multi-tenancy</PackageTags>
    <PackageProjectUrl>https://github.com/pinotechrdllc/Pinotechrd.Templates</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pinotechrdllc/Pinotechrd.Templates</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <PackageType>Template</PackageType>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <!-- Template content keeps dot files and folders such as .template.config and .gitignore. -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <!-- The package has no lib folder by design. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <EnableDefaultItems>false</EnableDefaultItems>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="templates\**\*" Exclude="templates\**\bin\**;templates\**\obj\**;templates\**\node_modules\**;templates\**\dist\**" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
