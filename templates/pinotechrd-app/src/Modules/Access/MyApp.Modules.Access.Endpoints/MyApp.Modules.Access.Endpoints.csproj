<Project Sdk="Microsoft.NET.Sdk">

  <!-- The module's endpoints and its composition root (AccessModule): the only project of the module the host references.
       With the Infrastructure project of this module, the only projects that reference the security library. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- Referenced directly, not only through the web building block, so the built-in validation generator runs here. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Pinotechrd.Security" />
    <PackageReference Include="Pinotechrd.Security.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\MyApp.BuildingBlocks.Web\MyApp.BuildingBlocks.Web.csproj" />
    <ProjectReference Include="..\MyApp.Modules.Access.Application\MyApp.Modules.Access.Application.csproj" />
    <ProjectReference Include="..\MyApp.Modules.Access.Infrastructure\MyApp.Modules.Access.Infrastructure.csproj" />
    <ProjectReference Include="..\MyApp.Modules.Access.Contracts\MyApp.Modules.Access.Contracts.csproj" />
  </ItemGroup>

</Project>
