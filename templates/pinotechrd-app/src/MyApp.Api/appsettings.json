{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Access": {
    "Jwt": {
      "Issuer": "MyApp",
      "Audience": "MyApp",
      "ExpiryMinutes": 10,
      "RefreshTokenExpiryDays": 7
    },
    "RefreshTokens": {
      "AbsoluteLifetime": "30.00:00:00"
    }
  },
  "Http": {
    "Cors": {
      "AllowedOrigins": []
    },
    "RateLimiting": {
      "PermitLimit": 300,
      "Window": "00:01:00",
      "Auth": {
        "PermitLimit": 10,
        "Window": "00:01:00"
      }
    },
    "ForwardedHeaders": {
      "KnownProxies": [],
      "KnownNetworks": []
    }
  }
}
