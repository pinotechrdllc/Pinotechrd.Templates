<Project>

  <!-- Settings shared by every project. LangVersion is left to the SDK default. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Pinned to the .NET 10 rule set: a newer SDK must not add rules that break an untouched project. -->
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <IsTestProject Condition="$(MSBuildProjectName.EndsWith('.Tests'))">true</IsTestProject>
  </PropertyGroup>

  <!-- Reproducible paths in CI builds (GitHub Actions and Azure Pipelines set these variables). -->
  <PropertyGroup Condition="'$(CI)' == 'true' or '$(TF_BUILD)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Dependencies (see Dependencies in README.md). Every project writes a packages.lock.json on restore; commit
       them. A CI build restores in locked mode: it fails (NU1004) instead of
       resolving versions that differ from the committed lock files. -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <!-- NuGet audit, stated even where it equals the .NET 10 default: every package, direct and transitive, is checked
       against the advisory database at every severity. An advisory (NU1901-NU1904), or vulnerability data that could
       not be read (NU1900, NU1905), fails a CI build; in a local build it stays a warning, so an advisory published
       today, or working offline, does not stop unrelated work. -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <NuGetAuditCodes>NU1900;NU1901;NU1902;NU1903;NU1904;NU1905</NuGetAuditCodes>
    <WarningsNotAsErrors Condition="'$(ContinuousIntegrationBuild)' != 'true'">$(WarningsNotAsErrors);$(NuGetAuditCodes)</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- The documentation file is generated everywhere because the unused-using rule (IDE0005) needs it at build. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Production code documents its public members; test projects do not have to (CS1591). -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
