<Project Sdk="Microsoft.NET.Sdk">

  <!-- Throwaway spike: measures the Wolverine EF Core outbox with one PostgreSQL schema per tenant. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WolverineFx" Version="6.64.2" />
    <PackageReference Include="WolverineFx.EntityFrameworkCore" Version="6.64.2" />
    <PackageReference Include="WolverineFx.Postgresql" Version="6.64.2" />
    <!-- Wolverine 6 moved runtime (Roslyn) code generation out of core; TypeLoadMode.Dynamic needs this. -->
    <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.64.2" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.17.0" />
  </ItemGroup>

</Project>
