<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Throwaway probe for Q5: generates the OpenAPI document at build time, as the template does, with no configuration. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Pinotechrd.Spikes.OpenApiProbe</RootNamespace>
    <IsPackable>false</IsPackable>
    <OpenApiDocumentsDirectory>$(BaseIntermediateOutputPath)openapi</OpenApiDocumentsDirectory>
    <DefineConstants Condition="'$(PinotechrdGuard)' == 'true'">$(DefineConstants);PINOTECHRD_GUARD</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pinotechrd.Security" Version="1.2.0-preview.2" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
